# SERA Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# Do NOT commit the .env file (it is in .gitignore).

# ─────────────────────────────────────────────────────────────────────────────
# Database
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/sera

# ─────────────────────────────────────────────────────────────────────────────
# App settings (optional overrides — defaults are usually fine)
# ─────────────────────────────────────────────────────────────────────────────
# APP_NAME=SERA Regulatory Monitoring Service
# DEBUG_MODE=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# "memory" (default) uses this slice's in-memory fakes. "postgres" is
# reserved for a teammate's real Postgres-backed implementations — not
# wired up yet (see app/ai/graph/deps.py).
ORG_DATA_BACKEND=memory
