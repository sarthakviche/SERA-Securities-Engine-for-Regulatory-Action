# SERA Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# Do NOT commit the .env file (it is in .gitignore).

# ─────────────────────────────────────────────────────────────────────────────
# Database
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/sera

# ─────────────────────────────────────────────────────────────────────────────
# App settings (optional overrides — defaults are usually fine)
# ─────────────────────────────────────────────────────────────────────────────
# APP_NAME=SERA Regulatory Monitoring Service
# DEBUG_MODE=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# "memory" (default) uses this slice's in-memory fakes. "postgres" is
# reserved for a teammate's real Postgres-backed implementations — not
# wired up yet (see app/ai/graph/deps.py).
ORG_DATA_BACKEND=memory

# ─────────────────────────────────────────────────────────────────────────────
# Notifications & Email (Resend)
# https://resend.com — free tier: 3 000 emails/month, no credit card required
# ─────────────────────────────────────────────────────────────────────────────

# Your Resend API key (starts with "re_").
# Leave blank to skip email delivery while keeping in-app notifications active.
RESEND_API_KEY=

# The "From" address shown in sent emails.
# Must be a verified domain or the Resend sandbox address for testing.
RESEND_FROM_EMAIL=noreply@sera-compliance.dev

# The email address that will receive compliance notification emails.
# In the MVP this is the single compliance officer / system admin.
NOTIFICATION_EMAIL_RECIPIENT=

# Set to false in local development to disable all email delivery.
# In-app (browser) notifications still work when this is false.
EMAIL_ENABLED=true

# Frontend base URL — used to build "Open in SERA" CTA links in emails.
FRONTEND_URL=http://localhost:5173
